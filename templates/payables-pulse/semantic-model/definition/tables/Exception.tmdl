table 'Exception'
	lineageTag: a0000000-0000-4000-8000-000000000200
	sourceLineageTag: [dbo].[FactException]

	measure 'Exceptions Created' = COUNTROWS('Exception')
		formatString: #,0
		lineageTag: a0000000-0000-4000-8000-000000000280

	measure 'Exceptions Resolved' = ```
			CALCULATE(
			    COUNTROWS('Exception'),
			    USERELATIONSHIP('Exception'[ResolvedDate], 'Date'[Date]),
			    'Exception'[IsResolved] = TRUE
			)
			```
		formatString: #,0
		lineageTag: a0000000-0000-4000-8000-000000000281

	measure 'Open Exceptions' = CALCULATE(COUNTROWS('Exception'), 'Exception'[IsOpen] = TRUE)
		formatString: #,0
		lineageTag: a0000000-0000-4000-8000-000000000282

	measure 'High Priority Open' = ```
			CALCULATE(
			    COUNTROWS('Exception'),
			    'Exception'[IsOpen] = TRUE,
			    'Exception'[IsHighPriority] = TRUE
			)
			```
		formatString: #,0
		lineageTag: a0000000-0000-4000-8000-000000000283

	measure 'SLA Breached' = ```
			CALCULATE(
			    COUNTROWS('Exception'),
			    'Exception'[IsOpen] = TRUE,
			    'Exception'[IsBreached] = TRUE
			)
			```
		formatString: #,0
		lineageTag: a0000000-0000-4000-8000-000000000284

	measure 'SLA Attainment' = DIVIDE([Open Exceptions] - [SLA Breached], [Open Exceptions])
		formatString: 0.0%
		lineageTag: a0000000-0000-4000-8000-000000000285

	measure 'Avg Resolution Hours' = AVERAGE('Exception'[ResolutionHours])
		formatString: #,0.0
		lineageTag: a0000000-0000-4000-8000-000000000286

	measure 'Median Resolution Hours' = MEDIANX('Exception', 'Exception'[ResolutionHours])
		formatString: #,0.0
		lineageTag: a0000000-0000-4000-8000-000000000287

	measure 'Exception Value at Risk' = CALCULATE(SUM('Exception'[AmountUsd]), 'Exception'[IsOpen] = TRUE)
		formatString: \$#,0
		lineageTag: a0000000-0000-4000-8000-000000000288

	measure 'Exception Rate' = DIVIDE([Exceptions Created], [Payment Count])
		formatString: 0.0%
		lineageTag: a0000000-0000-4000-8000-000000000289

	measure 'Escalated Exceptions' = CALCULATE(COUNTROWS('Exception'), 'Exception'[IsEscalated] = TRUE)
		formatString: #,0
		lineageTag: a0000000-0000-4000-8000-00000000028a

	measure 'Net Backlog Change' = [Exceptions Created] - [Exceptions Resolved]
		formatString: +#,0;-#,0;0
		lineageTag: a0000000-0000-4000-8000-00000000028b

	measure 'Cumulative Backlog' = ```
			VAR MaxDate = MAX('Date'[Date])
			VAR CreatedToDate =
			    CALCULATE(
			        COUNTROWS('Exception'),
			        REMOVEFILTERS('Date'),
			        'Exception'[CreatedDate] <= MaxDate
			    )
			VAR ResolvedToDate =
			    CALCULATE(
			        COUNTROWS('Exception'),
			        REMOVEFILTERS('Date'),
			        'Exception'[IsResolved] = TRUE,
			        'Exception'[ResolvedDate] <= MaxDate
			    )
			RETURN CreatedToDate - ResolvedToDate
			```
		formatString: #,0
		lineageTag: a0000000-0000-4000-8000-00000000028c

	measure 'Avg Daily Arrivals' = ```
			DIVIDE(
			    [Exceptions Created],
			    CALCULATE(DISTINCTCOUNT('Date'[Date]), ALLSELECTED('Date'))
			)
			```
		formatString: #,0.0
		lineageTag: a0000000-0000-4000-8000-00000000028d

	measure 'Avg Daily Resolutions' = ```
			DIVIDE(
			    [Exceptions Resolved],
			    CALCULATE(DISTINCTCOUNT('Date'[Date]), ALLSELECTED('Date'))
			)
			```
		formatString: #,0.0
		lineageTag: a0000000-0000-4000-8000-00000000028e

