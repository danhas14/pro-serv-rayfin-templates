table Payment
	lineageTag: a0000000-0000-4000-8000-000000000100
	sourceLineageTag: [dbo].[FactPayment]

	measure 'Payment Value' = SUM(Payment[AmountUsd])
		formatString: \$#,0
		lineageTag: a0000000-0000-4000-8000-000000000180

	measure 'Payment Count' = COUNTROWS(Payment)
		formatString: #,0
		lineageTag: a0000000-0000-4000-8000-000000000181

	measure 'Successful Payments' = CALCULATE([Payment Count], Payment[IsSuccessful] = TRUE)
		formatString: #,0
		lineageTag: a0000000-0000-4000-8000-000000000182

	measure 'Failed Payments' = CALCULATE([Payment Count], Payment[IsFailed] = TRUE)
		formatString: #,0
		lineageTag: a0000000-0000-4000-8000-000000000183

	measure 'Payment Success Rate' = DIVIDE([Successful Payments], [Payment Count])
		formatString: 0.0%
		lineageTag: a0000000-0000-4000-8000-000000000184

	measure 'Straight-Through Payments' = CALCULATE([Payment Count], Payment[IsStraightThrough] = TRUE)
		formatString: #,0
		lineageTag: a0000000-0000-4000-8000-000000000185

	measure 'Straight-Through Rate' = DIVIDE([Straight-Through Payments], [Payment Count])
		formatString: 0.0%
		lineageTag: a0000000-0000-4000-8000-000000000186

	measure 'Avg Processing Hours' = AVERAGE(Payment[ProcessingHours])
		formatString: #,0.0
		lineageTag: a0000000-0000-4000-8000-000000000187

	measure 'Avg Approval Hours' = AVERAGE(Payment[ApprovalHours])
		formatString: #,0.0
		lineageTag: a0000000-0000-4000-8000-000000000188

	measure 'Rebate Earned' = SUM(Payment[RebateAmount])
		formatString: \$#,0
		lineageTag: a0000000-0000-4000-8000-000000000189

	measure 'Rebate Opportunity' = SUM(Payment[RebateOpportunityUsd])
		formatString: \$#,0
		lineageTag: a0000000-0000-4000-8000-00000000018a

	measure 'Virtual Card Value' = CALCULATE([Payment Value], Payment[PaymentMethod] = "virtual-card")
		formatString: \$#,0
		lineageTag: a0000000-0000-4000-8000-00000000018b

	measure 'Virtual Card Adoption' = DIVIDE(CALCULATE([Payment Count], Payment[PaymentMethod] = "virtual-card"), [Payment Count])
		formatString: 0.0%
		lineageTag: a0000000-0000-4000-8000-00000000018c

	measure 'Cross-Border Value' = CALCULATE([Payment Value], Payment[IsCrossBorder] = TRUE)
		formatString: \$#,0
		lineageTag: a0000000-0000-4000-8000-00000000018d

	measure 'Domestic Value' = CALCULATE([Payment Value], Payment[IsCrossBorder] = FALSE)
		formatString: \$#,0
		lineageTag: a0000000-0000-4000-8000-00000000018e

	measure 'Avg Payment Value' = DIVIDE([Payment Value], [Payment Count])
		formatString: \$#,0
		lineageTag: a0000000-0000-4000-8000-00000000018f

	measure 'Payment Value PM' = CALCULATE([Payment Value], DATEADD('Date'[Date], -1, MONTH))
		formatString: \$#,0
		lineageTag: a0000000-0000-4000-8000-000000000190

	measure 'Payment Value MoM %' = DIVIDE([Payment Value] - [Payment Value PM], [Payment Value PM])
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: a0000000-0000-4000-8000-000000000191

	measure 'Payment Value 7D Avg' = ```
			AVERAGEX(
			    DATESINPERIOD('Date'[Date], MAX('Date'[Date]), -7, DAY),
			    [Payment Value]
			)
			```
		formatString: \$#,0
		lineageTag: a0000000-0000-4000-8000-000000000192

	measure 'Payment Value Rolling 30D' = ```
			CALCULATE(
			    [Payment Value],
			    DATESINPERIOD('Date'[Date], MAX('Date'[Date]), -30, DAY)
			)
			```
		formatString: \$#,0
		lineageTag: a0000000-0000-4000-8000-000000000193

