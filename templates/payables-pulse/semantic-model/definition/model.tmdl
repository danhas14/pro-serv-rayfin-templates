model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["DirectLake - payables-pulse"]

annotation PBI_ProTooling = ["DirectLakeOnOneLakeInWeb","WebModelingEdit"]

ref table 'Date'
ref table Payment
ref table 'Exception'
ref table Customer
ref table Vendor
ref table Specialist
ref table 'Exception Category'
ref table Resolution
