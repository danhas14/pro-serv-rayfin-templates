# Required when wiring the app to your deployed semantic model.
#
# Copy to `.env` (git-ignored) and fill in. These mirror the values in
# `fabric.yaml`, which is the source of truth for the app's model binding.

# Workspace that holds both the Fabric App and the semantic model.
FABRIC_WORKSPACE_ID=replace-with-target-workspace-id

# Set after deploying semantic-model/ — the app reads this model.
CORRECTIONS_SEMANTIC_MODEL_ID=replace-with-semantic-model-id

# Optional destination folder for the semantic model.
FABRIC_FOLDER_ID=replace-with-target-folder-id
