{
  "name": "corrections-digital-twin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "template": {
    "name": "corrections-digital-twin",
    "displayName": "Smart Corrections Digital Twin",
    "description": "Corrections operations center: interactive facility map with per-building hotspots, capacity and staffing telemetry, predictive alerts, and a grounded natural-language Operations Assistant over a Fabric semantic model."
  },
  "scripts": {
    "predev": "rayfin env --framework vite",
    "prebuild": "rayfin env --framework vite",
    "dev": "rayfin up --exclude-services staticHosting && vite",
    "build": "tsc -b && vite build",
    "build:fabric": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "rayfin:up": "rayfin up",
    "generate:semantic-model": "tsx scripts/generate-semantic-model.ts"
  },
  "dependencies": {
    "@microsoft/fabric-app-data": "^1.1.0",
    "@microsoft/fabric-app-data-embed-client": "^1.0.0",
    "@microsoft/fabric-app-data-proxy": "^1.0.0",
    "@microsoft/rayfin-auth-provider-fabric": "^1.33.1",
    "@microsoft/rayfin-client": "^1.36.2",
    "@microsoft/rayfin-core": "^1.36.2",
    "@microsoft/rayfin-data": "^1.36.2",
    "@tailwindcss/vite": "^4.1.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@microsoft/rayfin-cli": "^1.36.2",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "eslint": "^9.28.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "jsdom": "^24.1.0",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.3.2",
    "vitest": "^3.2.4"
  }
}
