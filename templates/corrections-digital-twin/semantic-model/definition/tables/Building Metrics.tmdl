/// Monthly operational readings per building. Population and officer counts are point-in-time stocks at month end; incidents are a flow accumulated over the month.
table 'Building Metrics'

	/// Foreign key to the Building dimension.
	column 'Building ID'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Building ID

	/// Foreign key to the Month dimension.
	column 'Month Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: Month Key

	/// Inmates recorded at this building at month end. Hidden in favour of the Inmates measure.
	column 'Inmate Count'
		dataType: int64
		isHidden
		summarizeBy: sum
		sourceColumn: Inmate Count

	/// Officers posted to this building at month end. Hidden in favour of the Officers measure.
	column 'Officer Count'
		dataType: int64
		isHidden
		summarizeBy: sum
		sourceColumn: Officer Count

	/// Reportable incidents recorded at this building during the month.
	column 'Incident Count'
		dataType: int64
		isHidden
		summarizeBy: sum
		sourceColumn: Incident Count

	/// Inmates held across the buildings in scope, taken at the latest month in context. Population is a point-in-time stock, so it is never summed across months.
	measure Inmates =
			VAR LastMonth = MAX ( 'Month'[Month Key] )
			RETURN
			    CALCULATE (
			        SUM ( 'Building Metrics'[Inmate Count] ),
			        REMOVEFILTERS ( 'Month' ),
			        'Month'[Month Key] = LastMonth
			    )
		formatString: #,0
		displayFolder: Population

	/// Correctional officers posted to the buildings in scope at the latest month in context. Officer strength is a stock, so it is never summed across months.
	measure Officers =
			VAR LastMonth = MAX ( 'Month'[Month Key] )
			RETURN
			    CALCULATE (
			        SUM ( 'Building Metrics'[Officer Count] ),
			        REMOVEFILTERS ( 'Month' ),
			        'Month'[Month Key] = LastMonth
			    )
		formatString: #,0
		displayFolder: Staffing

	/// Reportable incidents accumulated over every month in context. Use Monthly Incidents for a single-period figure.
	measure Incidents = SUM ( 'Building Metrics'[Incident Count] )
		formatString: #,0
		displayFolder: Incidents

	/// Reportable incidents recorded during the latest month in context, used for the current-period incident KPI.
	measure 'Monthly Incidents' =
			VAR LastMonth = MAX ( 'Month'[Month Key] )
			RETURN
			    CALCULATE (
			        SUM ( 'Building Metrics'[Incident Count] ),
			        REMOVEFILTERS ( 'Month' ),
			        'Month'[Month Key] = LastMonth
			    )
		formatString: #,0
		displayFolder: Incidents

	/// Inmates supervised per posted officer. Lower is better; each building type carries its own target.
	measure 'Inmates per Officer' = DIVIDE ( [Inmates], [Officers] )
		formatString: 0.00
		displayFolder: Staffing

	/// Incidents in the latest month per 100 inmates, which normalises incident volume for population size.
	measure 'Incidents per 100 Inmates' = DIVIDE ( [Monthly Incidents] * 100, [Inmates] )
		formatString: 0.0
		displayFolder: Incidents

	partition 'Building Metrics' = m
		mode: import
		source =
				let
					Source = #table(
						type table [#"Building ID" = text, #"Month Key" = Int64.Type, #"Inmate Count" = Int64.Type, #"Officer Count" = Int64.Type, #"Incident Count" = Int64.Type],
						{
