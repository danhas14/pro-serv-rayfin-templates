# =============================================================================
# Contract Analyzer App v2 — example environment file.
#
# Copy this file to `.env` and fill in the values for YOUR tenant. The rayfin
# CLI also generates `.env.local` automatically from `rayfin/.env`
# (`rayfin env --framework vite`) — it holds the workspace / item ids and the
# Rayfin publishable key. Vite merges both files.
#
# NOTHING HERE IS A SECRET. These are a public Entra SPA (public client) id —
# which has no client secret by design — and the publicly-invocable URLs of your
# own User Data Functions, which still require a valid delegated user token to
# call. Never put a client secret, API key, connection string, or SAS token in
# this file (or anywhere else in this repo): everything under VITE_* is inlined
# into the browser bundle at build time and is visible to anyone who loads the
# app.
#
# The Content Understanding and Foundry endpoints are deliberately NOT here.
# They live in `fabric-udf/function_app.py`, server-side, so the browser never
# learns which analyzer or which model deployment the app uses.
# =============================================================================

# Entra SPA app-registration client id (public client, no secret).
# Needs delegated permissions:
#   Power BI Service      -> UserDataFunction.Execute.All   (invoke the functions)
#   Azure Cognitive Services -> user_impersonation          (call Azure AI as the user)
VITE_FABRIC_SPA_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Optional. Defaults to `organizations` (any work/school account) when unset.
# VITE_FABRIC_TENANT_ID=00000000-0000-0000-0000-000000000000

# Public URL of the `analyze_contract` function you deploy from `fabric-udf/`.
# Copy it from the User Data Functions item in the Fabric portal.
VITE_UDF_ANALYZE_URL=https://<workspace-id-nodash>.z<n>.userdatafunctions.fabric.microsoft.com/v1/workspaces/<workspace-id>/userDataFunctions/<udf-item-id>/functions/analyze_contract/invoke

# Public URL of the `poll_contract` function from the same User Data Functions
# item. The browser calls this repeatedly while a contract is being analyzed.
VITE_UDF_POLL_URL=https://<workspace-id-nodash>.z<n>.userdatafunctions.fabric.microsoft.com/v1/workspaces/<workspace-id>/userDataFunctions/<udf-item-id>/functions/poll_contract/invoke

# Public URL of the `ask_contract` function from the same User Data Functions item.
VITE_UDF_ASK_URL=https://<workspace-id-nodash>.z<n>.userdatafunctions.fabric.microsoft.com/v1/workspaces/<workspace-id>/userDataFunctions/<udf-item-id>/functions/ask_contract/invoke

# -----------------------------------------------------------------------------
# Local development only. Credentials for the bundled local backend, which has
# no Fabric/Entra. Set these if you run `npm run dev` against a localhost API.
#
# They are read from the environment rather than hardcoded because everything
# under VITE_* is inlined into the browser bundle at build time. The local-dev
# sign-in path is also compiled out of production builds entirely (see the
# `import.meta.env.DEV` guard in src/services/bootstrap.ts), so leaving these
# unset is correct for any deployed build.
# -----------------------------------------------------------------------------
# VITE_LOCAL_DEV_EMAIL=dev@contoso.com
# VITE_LOCAL_DEV_PASSWORD=<choose your own>
