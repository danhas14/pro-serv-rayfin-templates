# =============================================================================
# Regression Test Studio — example environment file.
#
# Copy to `.env` and fill in the values for YOUR tenant. The rayfin CLI also
# generates `.env.local` (`rayfin env --framework vite`) holding the workspace
# and item ids and the Rayfin publishable key. Vite merges both files.
#
# NOTHING HERE IS A SECRET. `VITE_*` values are inlined into the browser bundle
# at build time and are readable by anyone who loads the app. The Entra client
# id below is a *public client* registration, which has no client secret by
# design. Never put a client secret, API key, connection string, or SAS token
# in this file or anywhere else in this repo.
#
# Credentials belonging to the applications under test are NOT configured here
# either. Interactive agent runs collect them per run and hold them only in the
# browser; the container runner reads them from Azure Key Vault. See README.md.
# =============================================================================

# Entra SPA app-registration client id (public client, auth-code + PKCE).
# Requires the delegated permission:
#   Azure Cognitive Services -> user_impersonation   (call the Foundry agent as the user)
# and the app's hosting origin registered as a Single-page application
# redirect URI.
VITE_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Optional. Defaults to `organizations` when unset.
VITE_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000

# Foundry agent responses endpoint. `api-version=v1` is appended by the client.
# Shape:
#   https://<ai-account>.services.ai.azure.com/api/projects/<project>/agents/<agent>/endpoint/protocols/openai/responses
VITE_AGENT_ENDPOINT=https://YOUR-AI-ACCOUNT.services.ai.azure.com/api/projects/YOUR-PROJECT/agents/YOUR-AGENT/endpoint/protocols/openai/responses

# Seconds the browser waits for one agent invocation before giving up.
VITE_AGENT_TIMEOUT_SECONDS=600

# Container App runner base URL. When set, a "Run with screenshots" button
# appears on the test editor and screenshots become viewable from run detail.
# Leave blank to run agent-only, with no screenshot evidence.
# Shape: https://<app-name>.<environment-id>.<region>.azurecontainerapps.io
VITE_RUNNER_URL=
